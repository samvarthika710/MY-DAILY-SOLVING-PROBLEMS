import java.util.*;
class Main{
    public static void main(String[] args){
        int[] arr = {4,2,3,1};
        cyclicsort(arr);
        System.out.print(Arrays.toString(arr));
        
    }
    
    static void cyclicsort(int[] arr){
        int i = 0;
        while(i < arr.length){
            int correct = arr[i]-1;
            if(arr[i] != arr[correct]){
                swap(arr,i,correct);
            }
            else{
                i++;
            }
        }
    }
    
    
    
    static void swap(int[] arr, int first, int second){
        int temp = arr[first];
        arr[first] = arr[second];
        arr[second] = temp;
    }
    
}

