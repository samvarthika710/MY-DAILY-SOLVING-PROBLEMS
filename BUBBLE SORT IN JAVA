import java.util.*;
class Main{
    public static void main(String[] args){
        int[] matrix = {5,4,7,3,1,2,9};
        bubble(matrix);
        System.out.print(Arrays.toString(matrix));
        
    }

static void bubble(int[] arr){
    boolean swapped;
    for(int i= 0 ; i < arr.length ; i++){
        swapped = false;
        for(int j = 1; j < arr.length - i ; j++){
            if(arr[j] < arr[j - 1]){
                int temp = arr[j];
                arr[j] = arr[j - 1];
                arr[j - 1] = temp;
                swapped = true;
            }
            
        }
        if(!swapped){
            break;
        }
        
    }
}
}
