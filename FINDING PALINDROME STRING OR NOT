class Main{
    public static void main(String[] args){
        String nums = "abcdcba";
        if(palindrome(nums)){
            System.out.print("It is a palindrome");
        }
        else{
            System.out.print("It is not palindrome");
        }
        
    }
    static boolean palindrome(String nums){
        for(int i = 0; i < nums.length(); i++){
            int start = nums.charAt(i);
            int end = nums.charAt(nums.length() - 1 - i);
            if(start!=end){
                return false;
            }
        }
        return true;
    }
}
