import java.util.*;
class Main{
    public static void main(String[] args){
        int[] arr = {73,4,6,4,3,7,66,4,1};
        Insertion(arr);
        System.out.print(Arrays.toString(arr));
        
    }
    static void Insertion(int[] arr){
        int n = arr.length;
        for(int i = 0; i <= n-2; i++){  // Because of if i is equal to last index the j is i+1 so index out of bound will occur
            for(int j = i+1; j>0; j--){
                if(arr[j] < arr[j-1]){
                    swap(arr, j -1, j);
                }
                else{  
                    break;    //if one swap fails then break because the left side array is sorted
            }
        }
    }
    }
    static void swap(int[] arr, int first,int second ){
        int temp = arr[first];
        arr[first] = arr[second];
        arr[second] = temp;
        
    }
}
